# Environment variables for SMTP Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sakhil2027@gmail.com
SMTP_PASSWORD=your_16_digit_gmail_app_password
NOTIFICATION_EMAIL=sakhil2027@gmail.com

# Qdrant & Embedding RAG Configuration
ENVIRONMENT=development
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=portfolio_knowledge
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Free LLM Configuration (Option 2: Groq Cloud - Free Llama 3.1 / Option 1: Google Gemini Free)
# Get a 100% free Groq API key at: https://console.groq.com/keys
GROQ_API_KEY=your_free_groq_api_key_here
LLM_MODEL=llama-3.1-8b-instant

# Optional: Google Gemini Free API Key (from https://aistudio.google.com)
# GEMINI_API_KEY=your_free_gemini_api_key_here
